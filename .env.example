# ===========================
# Application
# ===========================
APP_NAME=APP NAME
PUBLIC_URL=public
# ===========================
# Database (PostgreSQL)
# ===========================
DB_HOST=localhost
DB_PORT=port
DB_USER=user
DB_PASSWORD=password
DB_NAME=db_name
# ===========================
# Security
# ===========================
SECRET_KEY=secret str
ACCESS_TOKEN_EXPIRE_MINUTES=0
REFRESH_TOKEN_EXPIRE_DAYS=0
# ===========================
# REDIS
# ===========================
REDIS_URL=redis
# ===========================
# resend (email_verification)
# ===========================
RESEND_API_KEY=RESEND_API_KEY
TEMPLATE_ID=template
TEMPLATE_PASSWORD_ID=template
EXPIRE_EMAIL_HOURS=expire
# ===========================
# google Oauth
# ===========================
GOOGLE_CLIENT_ID=id
GOOGLE_CLIENT_SECRET=secret
GOOGLE_REDIRECT_URI=url